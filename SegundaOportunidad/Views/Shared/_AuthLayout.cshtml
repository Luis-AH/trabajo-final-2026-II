@inject IConfiguration Configuration
@inject IWebHostEnvironment HostEnvironment
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SegundaOportunidad</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8f9fa; margin: 0; padding: 0; }
        .auth-container { display: flex; min-height: 100vh; }
        .auth-brand-panel { 
            flex: 1; 
            background-color: #1b4332; 
            color: #ffffff; 
            display: flex; 
            flex-direction: column; 
            justify-content: center; 
            align-items: center; 
            padding: 3rem; 
            text-align: center;
        }
        .auth-brand-panel h1 { font-weight: 700; margin-bottom: 1rem; }
        .auth-brand-panel p { font-size: 1.25rem; opacity: 0.9; }
        .auth-form-panel { 
            flex: 1; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            padding: 2rem; 
            background-color: #ffffff; 
        }
        .auth-form-wrapper { width: 100%; max-width: 450px; }
        .btn-brand { background-color: #1b4332; color: #fff; font-weight: 500; padding: 0.75rem; border-radius: 8px; border: none; transition: 0.3s; width: 100%; }
        .btn-brand:hover { background-color: #2d6a4f; color: #fff; }
        .form-control { border-radius: 8px; padding: 0.75rem; }
        .nav-tabs { border-bottom: none; margin-bottom: 2rem; }
        .nav-tabs .nav-link { color: #6c757d; font-weight: 500; border: none; border-bottom: 3px solid transparent; padding: 0.5rem 0; margin-right: 2rem; }
        .nav-tabs .nav-link.active { color: #1b4332; border-bottom: 3px solid #1b4332; background: none; }
        @@media (max-width: 768px) {
            .auth-container { flex-direction: column; }
            .auth-brand-panel { padding: 3rem 1.5rem; flex: none; min-height: 30vh; }
        }
    </style>
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/experience.css" asp-append-version="true" />
</head>
<body>
@if(HostEnvironment.IsEnvironment("Demo")||(HostEnvironment.IsDevelopment()&&Configuration.GetValue<bool>("Demo:UseDataset"))){<aside class="demo-banner">ENTORNO DEMO · Cuentas ficticias y datos de ensayo</aside>}
    <div class="auth-container">
        <div class="auth-brand-panel">
            <a class="auth-logo" asp-area="" asp-controller="Home" asp-action="Index"><span class="auth-logo-mark" aria-hidden="true">↻</span>SegundaOportunidad</a>
            <div class="auth-kicker">Menos desperdicio. Más posibilidades.</div>
            <h1>Las buenas historias<br>merecen <em>otra vida.</em></h1>
            <p>Conecta con tu comunidad. Intercambia, comparte y descubre lo que todavía tiene mucho por dar.</p>
            <div class="auth-illustration" aria-hidden="true">
                <div class="auth-orbit"></div>
                <div class="auth-item auth-item-book"><svg width="44" height="54" viewBox="0 0 44 54" fill="none"><rect x="6" y="4" width="32" height="44" rx="4" stroke="currentColor" stroke-width="2"/><path d="M13 4v44M19 16h12M19 23h9M6 42h32" stroke="currentColor" stroke-width="2"/></svg></div>
                <div class="auth-item auth-item-plant"><svg width="50" height="62" viewBox="0 0 50 62" fill="none"><path d="M15 39h22l-4 17H19l-4-17Z" fill="currentColor" opacity=".6"/><path d="M26 39V16M26 29C11 29 7 18 10 10c12 0 17 8 16 19ZM27 22C27 10 35 6 43 7c1 10-6 16-16 15Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></div>
                <div class="auth-item auth-item-cycle"><svg width="38" height="38" viewBox="0 0 38 38" fill="none"><path d="M29 12A12 12 0 0 0 8 13M8 13V6M8 13h7M9 26a12 12 0 0 0 21-1M30 25v7M30 25h-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
            </div>
            <p class="auth-footer-note">Pequeñas acciones. Nuevas oportunidades.</p>
        </div>
        <div class="auth-form-panel">
            <div class="auth-form-wrapper">
                @RenderBody()
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

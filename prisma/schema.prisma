// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Cliente {
  id                   String                 @id @default(uuid())
  nombre               String
  email                String                 @unique
  reputacion           Int                    @default(0)
  
  articulos            Articulo[]             @relation("Propietario")
  propuestasOfertadas  PropuestaIntercambio[] @relation("Ofertante")
  propuestasRecibidas  PropuestaIntercambio[] @relation("Receptor")
}

model Articulo {
  id                  String                 @id @default(uuid())
  titulo              String
  descripcion         String?
  precio              Float?
  tipo                String                 
  
  propietarioId       String
  propietario         Cliente                @relation("Propietario", fields: [propietarioId], references: [id])
  
  propuestasOfertado  PropuestaIntercambio[] @relation("ArticuloOfertado")
  propuestasDeseado   PropuestaIntercambio[] @relation("ArticuloDeseado")
}

model PropuestaIntercambio {
  id                  String   @id @default(uuid())
  estado              String   @default("Pendiente") 
  
  ofertanteId         String
  ofertante           Cliente  @relation("Ofertante", fields: [ofertanteId], references: [id])
  
  receptorId          String
  receptor            Cliente  @relation("Receptor", fields: [receptorId], references: [id])
  
  articuloOfertadoId  String
  articuloOfertado    Articulo @relation("ArticuloOfertado", fields: [articuloOfertadoId], references: [id])
  
  articuloDeseadoId   String
  articuloDeseado     Articulo @relation("ArticuloDeseado", fields: [articuloDeseadoId], references: [id])
}
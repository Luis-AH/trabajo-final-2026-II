@model SegundaOportunidad.Models.GuardReportsViewModel
@{ Layout="_DashboardLayout"; ViewData["Title"]="Resumir reportes con IA"; }
<main class="p-3 p-md-5 guard-page"><partial name="_GuardNav" /><div class="guard-page-heading"><span class="guard-eyebrow">03 / Hechos y antecedentes</span><h1>Revisa con más contexto.</h1><p>Encuentra un reporte y solicita un resumen de los hechos denunciados y los antecedentes disponibles.</p></div><form method="get" class="card p-4 mb-4"><div class="row g-3 align-items-end"><div class="col-md-7"><label for="busqueda">Buscar en descripción o referencia</label><input id="busqueda" name="busqueda" value="@Model.Busqueda" maxlength="150" class="form-control" placeholder="Palabra clave o referencia del reporte" /></div><div class="col-md-3"><label for="estado">Estado</label><select id="estado" name="estado" class="form-select"><option value="">Todos</option>@foreach(var state in Enum.GetValues<EstadoReporte>()) { <option value="@state" selected="@(state==Model.Estado)">@state</option> }</select></div><div class="col-md-2"><button class="btn btn-brand w-100">Buscar</button></div></div></form><p class="guard-micro">@Model.Total reportes · página @Model.Pagina de @Model.Paginas</p>
@if(Model.Total==0) { <div class="guard-empty"><span aria-hidden="true">≋</span><h2>No hay reportes para estos filtros</h2><p>Los reportes aparecerán aquí cuando la comunidad los registre.</p></div> }
<div class="guard-history-grid">@foreach(var r in Model.Reportes) { <article class="guard-report-card"><span class="guard-pill">@r.Estado</span><h2 class="h5 mt-3">@r.Motivo</h2><p class="guard-clamp">@r.Descripcion</p><span class="guard-micro">@r.CreadoUtc.ToString("yyyy-MM-dd HH:mm") UTC</span><a asp-action="Resumen" asp-route-id="@r.Id" class="btn btn-outline-brand w-100 mt-3">Resumir este reporte →</a></article> }</div><nav class="guard-pagination" aria-label="Paginación de reportes">@if(Model.Pagina>1) { <a asp-route-pagina="@(Model.Pagina-1)" asp-route-busqueda="@Model.Busqueda" asp-route-estado="@Model.Estado">← Anterior</a> }<span>@Model.Pagina / @Model.Paginas</span>@if(Model.Pagina<Model.Paginas) { <a asp-route-pagina="@(Model.Pagina+1)" asp-route-busqueda="@Model.Busqueda" asp-route-estado="@Model.Estado">Siguiente →</a> }</nav></main>

@model SegundaOportunidad.Models.SeguridadViewModel
@{ Layout="_DashboardLayout"; ViewData["Title"]="Seguridad administrativa"; }
<main class="p-3 p-md-5"><a asp-controller="Admin" asp-action="Index">Dashboard</a><h1 class="h2 text-brand mt-3">Seguridad administrativa</h1><p>Roles de tu cuenta: @(Model.RolesPropios.Count == 0 ? "Sin roles asignados" : string.Join(", ",Model.RolesPropios))</p><div class="d-flex flex-wrap gap-3 mb-4"><a asp-action="Cambiar" class="btn btn-brand">Cambiar mi contraseña</a><a asp-action="Recuperar" class="btn btn-outline-brand">Solicitar recuperación por correo</a></div>
@if(!Model.CorreoConfigurado) { <div class="alert alert-warning">Envío de correo pendiente de configuración SMTP. No se enviarán enlaces de recuperación hasta configurarlo.</div> }
<h2 class="h5">Roles existentes</h2><table class="table bg-white"><thead><tr><th>Rol</th><th>Cuentas asignadas</th></tr></thead><tbody>@foreach(var rol in Model.Roles) { <tr><td>@rol.Nombre</td><td>@rol.Usuarios</td></tr> }</tbody></table><h2 class="h5">Permisos aplicados</h2><ul><li>Admin: dashboard global, publicaciones, usuarios y sanciones, reportes, AdminGuard y esta sección.</li><li>Cuenta autenticada: publicar, proponer intercambios, mensajería y reportar, sujeta a suspensiones.</li><li>Visitante: catálogo, login y solicitud de recuperación.</li></ul><p>Los usuarios sin rol Admin conservan sus funciones habituales. Esta pantalla consulta roles; no permite asignarlos ni conocer contraseñas ajenas. Las contraseñas se validan con Identity y nunca se recuperan en texto plano.</p></main>

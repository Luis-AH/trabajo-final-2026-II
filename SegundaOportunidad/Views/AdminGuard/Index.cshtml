@model SegundaOportunidad.Models.PanelAdminGuardViewModel
@{ Layout="_DashboardLayout"; ViewData["Title"]="AdminGuard IA"; }
<main class="p-3 p-md-5 guard-page">
<partial name="_GuardNav" />
<div class="guard-welcome"><span class="guard-eyebrow">Tu espacio de revisión asistida</span><h1>¿Qué quieres hacer hoy?</h1><p>Elige una tarea. AdminGuard te ayuda a interpretar información y revisar señales; tú mantienes el control de las decisiones.</p><span class="guard-pill">@(Model.Configurado ? "IA configurada" : "Configuración de IA pendiente") · acceso exclusivo Admin</span></div>
@Html.AntiForgeryToken()
<div class="guard-action-grid">
<a asp-action="Datos" class="guard-action-card"><span class="guard-action-number">01 / INFORMACIÓN</span><span class="guard-action-icon" aria-hidden="true">↗</span><h2>Consultar datos</h2><p>Pregunta por estadísticas de la comunidad y prioridades de revisión con datos agregados reales.</p><span class="guard-action-link">Abrir consultas <span aria-hidden="true">→</span></span></a>
<a asp-action="Publicaciones" class="guard-action-card"><span class="guard-action-number">02 / PUBLICACIONES</span><span class="guard-action-icon" aria-hidden="true">▧</span><h2>Analizar publicaciones</h2><p>Encuentra un artículo por su nombre y contrasta su fotografía, título y descripción.</p><span class="guard-action-link">Explorar publicaciones <span aria-hidden="true">→</span></span></a>
<a asp-action="Reportes" class="guard-action-card"><span class="guard-action-number">03 / ANTECEDENTES</span><span class="guard-action-icon" aria-hidden="true">≋</span><h2>Resumir reportes</h2><p>Organiza los hechos denunciados, consulta antecedentes y prepara una revisión informada.</p><span class="guard-action-link">Abrir reportes <span aria-hidden="true">→</span></span></a>
</div>
<div class="guard-note mt-4">La IA orienta, no certifica legitimidad ni sanciona. Cada consulta y su resultado quedan registrados.</div>
<partial name="_GuardHistory" model="Model" />
</main>

@model IEnumerable<SegundaOportunidad.Models.ApplicationUser>
@{
    ViewData["Title"] = "Panel de Supervisor";
    Layout = "_DashboardLayout";
}

<main class="p-4 p-md-5">
    <div class="mb-5 d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold text-dark mb-1">Panel de Supervisor</h2>
            <p class="text-muted">Solicitudes de verificación de identidad pendientes.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 py-3 text-muted fw-bold">USUARIO</th>
                            <th class="py-3 text-muted fw-bold">CORREO</th>
                            <th class="py-3 text-muted fw-bold">DNI ENVIADO</th>
                            <th class="pe-4 py-3 text-muted fw-bold text-end">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <i class="bi bi-check-circle display-4 d-block mb-3"></i>
                                    Todo al día. No hay solicitudes pendientes.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var user in Model)
                            {
                                <tr>
                                    <td class="ps-4 py-3 fw-bold">@user.FullName</td>
                                    <td class="py-3 text-muted">@user.Email</td>
                                    <td class="py-3 fw-bold text-brand">@user.Dni</td>
                                    <td class="pe-4 py-3 text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <form asp-action="Reject" asp-route-id="@user.Id" method="post">
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                                    <i class="bi bi-x-circle me-1"></i> Rechazar
                                                </button>
                                            </form>
                                            <form asp-action="Approve" asp-route-id="@user.Id" method="post">
                                                <button type="submit" class="btn btn-brand btn-sm rounded-pill px-3 text-white">
                                                    <i class="bi bi-check-circle me-1"></i> Aprobar
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>


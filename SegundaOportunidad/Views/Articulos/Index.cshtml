@model IEnumerable<SegundaOportunidad.Models.Articulo>

@{
    ViewData["Title"] = "Explorar Artículos";
    Layout = "_DashboardLayout";
}

<main class="p-4 p-md-5">
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h1 class="display-6 fw-bold text-brand">Explorar Catálogo</h1>
            <p class="text-muted">Descubre artículos para comprar, intercambiar o recibir en donación.</p>
        </div>
        <div class="col-md-6 text-md-end">
            <a asp-action="Create" class="btn btn-brand px-4 py-2 rounded-pill shadow-sm">
                <i class="bi bi-plus-circle me-2"></i>Publicar Artículo
            </a>
        </div>
    </div>

    <!-- Filtros de búsqueda -->
    <div class="card border-0 shadow-sm rounded-4 mb-5 p-4 bg-light">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchString" class="form-control border-start-0 ps-0" placeholder="¿Qué estás buscando?..." value="@Context.Request.Query["searchString"]">
                </div>
            </div>
            <div class="col-md-4">
                <select name="categoriaId" class="form-select text-muted" asp-items="ViewBag.Categorias">
                    <option value="">Todas las Categorías</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-outline-brand w-100">Filtrar</button>
            </div>
        </form>
    </div>

    <!-- Grilla de Artículos -->
    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var item in Model) {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm hover-lift rounded-4 overflow-hidden">
                    @if (string.IsNullOrEmpty(item.ImageUrl)) {
                        <div class="bg-light text-center py-5 text-muted" style="height: 200px;">
                            <i class="bi bi-image" style="font-size: 3rem;"></i>
                            <p class="mt-2 small">Sin imagen</p>
                        </div>
                    } else {
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title" style="height: 200px; object-fit: cover;">
                    }
                    
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-brand-light text-brand rounded-pill px-3">@item.Categoria?.Name</span>
                            <span class="badge bg-secondary rounded-pill">@item.Modalidad</span>
                        </div>
                        
                        <h5 class="card-title fw-bold text-dark mt-3 text-truncate">@item.Title</h5>
                        
                        @if (item.Modalidad == SegundaOportunidad.Models.ModalidadArticulo.Venta) {
                            <h4 class="text-brand fw-bold mb-3">S/ @item.Price</h4>
                        } else if (item.Modalidad == SegundaOportunidad.Models.ModalidadArticulo.Intercambio) {
                            <p class="text-muted small mb-3"><i class="bi bi-arrow-left-right me-1"></i> Busco intercambio</p>
                        } else {
                            <h4 class="text-success fw-bold mb-3">Gratis</h4>
                        }

                        <p class="card-text text-muted small text-truncate-2">@item.Description</p>
                        
                        <div class="d-flex align-items-center mt-3 pt-3 border-top">
                            <div class="rounded-circle bg-light d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px;">
                                <i class="bi bi-person text-muted"></i>
                            </div>
                            <small class="text-muted text-truncate flex-grow-1">@item.User?.FullName</small>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-0 p-3 pt-0 text-center">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-light text-brand w-100 rounded-pill hover-bg-brand">
                            Ver Detalles
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    @if(!Model.Any()) {
        <div class="text-center py-5">
            <i class="bi bi-search text-muted mb-3 d-block" style="font-size: 4rem;"></i>
            <h3 class="text-muted">No se encontraron artículos</h3>
            <p class="text-muted">Prueba buscando con otros términos o seleccionando otra categoría.</p>
        </div>
    }
</main>

<style>
    .hover-lift {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }
    .hover-lift:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;  
        overflow: hidden;
    }
    .hover-bg-brand:hover {
        background-color: var(--bs-brand) !important;
        color: white !important;
    }
</style>

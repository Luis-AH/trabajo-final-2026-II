@model SegundaOportunidad.Controllers.AdminMlViewModel
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Machine Learning"; }
<main class="p-3 p-md-5">
    <h1 class="text-brand">Machine Learning con ML.NET</h1>
    <p class="text-muted">Clasifica el texto de una publicación y busca artículos relacionados.</p>
    <form method="post" class="card rounded-4 p-4 mb-4">
        <label class="form-label fw-bold" for="texto">Texto para revisar</label>
        <textarea class="form-control mb-3" id="texto" name="texto" maxlength="2000" required rows="3">@Model.Texto</textarea>
        <label class="form-label fw-bold" for="consulta">Buscar recomendaciones</label>
        <input class="form-control mb-3" id="consulta" name="consulta" maxlength="300" value="@Model.Consulta" required />
        <button class="btn btn-brand align-self-start" type="submit">Clasificar y recomendar</button>
    </form>
    @if (Model.Clasificacion is { } result)
    {
        <section class="card rounded-4 p-4 mb-4" aria-live="polite">
            <h2 class="h4">@result.Categoria</h2>
            <p class="mb-1">Puntuación de revisión del modelo: @result.ProbabilidadRevision.ToString("P1")</p>
            <p class="text-muted mb-1">@result.Modelo</p>
            <p class="small mb-0">@result.Alcance</p>
        </section>
    }
    <h2 class="h4">Publicaciones relacionadas</h2>
    <p class="text-muted">@Model.Recomendaciones?.Algoritmo</p>
    <div class="row g-3">
    @foreach (var article in Model.Recomendaciones?.Publicaciones ?? [])
    {
        <div class="col-md-6 col-xl-4"><article class="card h-100 rounded-4 overflow-hidden">
            @if (!string.IsNullOrEmpty(article.Imagen)) { <img src="@article.Imagen" alt="" class="card-img-top" style="height:160px;object-fit:cover" referrerpolicy="no-referrer" /> }
            <div class="card-body"><h3 class="h5">@article.Titulo</h3><p>@article.Categoria · @article.Estado</p>
                <p>Afinidad @article.Similitud.ToString("P1")</p><a class="btn btn-outline-brand" href="@article.Enlace">Ver publicación</a></div>
        </article></div>
    }
    </div>
    @if (Model.Recomendaciones?.Publicaciones.Count == 0) { <p>No hay publicaciones relacionadas disponibles.</p> }
</main>

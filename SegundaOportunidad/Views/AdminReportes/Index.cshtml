@model SegundaOportunidad.Models.BandejaReportesViewModel
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Reportes y moderación"; }
<main class="p-3 p-md-5"><a asp-controller="Admin" asp-action="Index">Dashboard</a><h1 class="h2 text-brand mt-3">Reportes y moderación</h1><form method="get" class="row g-3 mb-4"><input type="hidden" name="usuarioId" value="@ViewBag.UsuarioId" /><div class="col-md-5"><label for="estado">Estado</label><select id="estado" name="estado" class="form-select"><option value="">Todos</option>@foreach(var e in Enum.GetValues<EstadoReporte>()) { <option value="@e" selected="@(e == Model.Estado)">@e</option> }</select></div><div class="col-md-5"><label for="motivo">Motivo</label><select id="motivo" name="motivo" class="form-select"><option value="">Todos</option>@foreach(var m in Enum.GetValues<MotivoReporte>()) { <option value="@m" selected="@(m == Model.Motivo)">@m</option> }</select></div><div class="col-md-2 align-self-end"><button class="btn btn-brand">Filtrar</button></div></form><p>@Model.Total reportes · página @Model.Pagina de @Model.Paginas</p><div class="table-responsive"><table class="table bg-white"><thead><tr><th>Objetivo</th><th>Motivo</th><th>Estado</th><th>Fecha UTC</th><th>Revisión</th></tr></thead><tbody>@foreach(var r in Model.Reportes) { <tr><td>@r.Denunciado.FullName<br /><small>@(r.ArticuloId == null ? "Comportamiento de usuario" : "Publicación")</small></td><td>@r.Motivo</td><td>@r.Estado</td><td>@r.CreadoUtc.ToString("yyyy-MM-dd HH:mm")</td><td><a asp-action="Detalle" asp-route-id="@r.Id">Revisar</a></td></tr> }</tbody></table></div>@if(Model.Total == 0) { <p>No hay reportes para estos filtros.</p> }<nav class="d-flex gap-3" aria-label="Paginación">@if(Model.Pagina > 1) { <a asp-route-pagina="@(Model.Pagina-1)" asp-route-estado="@Model.Estado" asp-route-motivo="@Model.Motivo" asp-route-usuarioId="@ViewBag.UsuarioId">Anterior</a> } @if(Model.Pagina < Model.Paginas) { <a asp-route-pagina="@(Model.Pagina+1)" asp-route-estado="@Model.Estado" asp-route-motivo="@Model.Motivo" asp-route-usuarioId="@ViewBag.UsuarioId">Siguiente</a> }</nav></main>

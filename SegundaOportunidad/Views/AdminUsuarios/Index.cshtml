@model SegundaOportunidad.Models.AdminUsuariosViewModel
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Usuarios"; }
<main class="p-3 p-md-5"><a asp-controller="Admin" asp-action="Index">Dashboard</a><h1 class="h2 text-brand mt-3">Usuarios</h1>
<form method="get" class="row g-3 mb-4"><div class="col-md-6"><label for="busqueda">Nombre o correo</label><input id="busqueda" name="busqueda" value="@Model.Busqueda" maxlength="150" class="form-control" /></div><div class="col-md-4"><label for="suspendidos">Estado de cuenta</label><select id="suspendidos" name="suspendidos" class="form-select"><option value="">Todos</option><option value="true" selected="@(Model.Suspendidos == true)">Suspendidos</option><option value="false" selected="@(Model.Suspendidos == false)">Sin suspensión vigente</option></select></div><div class="col-md-2 align-self-end"><button class="btn btn-brand">Filtrar</button></div></form>
<p>@Model.Total usuarios · página @Model.Pagina de @Model.Paginas</p><div class="table-responsive"><table class="table bg-white"><thead><tr><th>Usuario</th><th>Registro UTC</th><th>Publicaciones</th><th>Intercambios completados</th><th>Reportes recibidos</th><th>Estado</th><th>Perfil</th></tr></thead><tbody>
@foreach(var fila in Model.Usuarios) { var u = fila.Usuario; <tr><td>@u.FullName<br />@u.Email</td><td>@(u.RegisteredAtUtc?.ToString("yyyy-MM-dd") ?? "Sin registro histórico")</td><td>@fila.Publicaciones</td><td>@fila.Intercambios</td><td>@fila.Reportes</td><td>@(u.AccountSuspendedUntilUtc > Model.AhoraUtc ? "Cuenta suspendida" : "Sin suspensión de cuenta") @if(u.PublishingSuspendedUntilUtc > Model.AhoraUtc) { <small>Publicaciones suspendidas</small> }</td><td><a asp-action="Detalle" asp-route-id="@u.Id">Consultar</a></td></tr> }
</tbody></table></div>@if(Model.Total == 0) { <p>Sin resultados.</p> }
<nav class="d-flex gap-3" aria-label="Paginación">@if(Model.Pagina > 1) { <a asp-route-pagina="@(Model.Pagina-1)" asp-route-busqueda="@Model.Busqueda" asp-route-suspendidos="@Model.Suspendidos">Anterior</a> } @if(Model.Pagina < Model.Paginas) { <a asp-route-pagina="@(Model.Pagina+1)" asp-route-busqueda="@Model.Busqueda" asp-route-suspendidos="@Model.Suspendidos">Siguiente</a> }</nav><p class="text-muted mt-3">Los reportes recibidos no equivalen a infracciones confirmadas. No se inventan fechas de registro de cuentas antiguas.</p></main>

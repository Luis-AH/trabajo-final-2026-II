@model SegundaOportunidad.Models.PanelAdminGuardViewModel
@if(Model.Error!=null) { <div class="alert alert-danger" role="alert">@Model.Error</div> }
@if(!Model.Configurado) { <div class="alert alert-warning">Configura la clave y el modelo de Groq en User Secrets para realizar consultas reales.</div> }
<form asp-controller="AdminGuard" asp-action="Consultar" method="post" class="guard-consult-form"><input type="hidden" name="Tipo" value="@Model.Consulta.Tipo" /><input type="hidden" name="ObjetivoId" value="@Model.Consulta.ObjetivoId" /><div asp-validation-summary="All" class="text-danger" role="alert"></div><label for="Pregunta" class="form-label">¿Qué necesitas revisar?</label><textarea id="Pregunta" name="Pregunta" required minlength="5" maxlength="500" rows="5" class="form-control mb-3">@Model.Consulta.Pregunta</textarea><p class="guard-micro">Se envían a Groq solo los datos necesarios para esta consulta. No incluyas secretos ni información personal innecesaria. Diez intentos por administrador por hora.</p><button class="btn btn-brand" disabled="@(!Model.Configurado)">@(Model.Consulta.Tipo==TipoConsultaAdminGuard.Publicacion ? "Analizar señales y coherencia" : Model.Consulta.Tipo==TipoConsultaAdminGuard.Reporte ? "Generar resumen y antecedentes" : "Consultar datos con IA") <span aria-hidden="true">↗</span></button><p class="guard-micro mt-3 mb-0">El resultado se guardará en tu historial. Ninguna consulta aplica sanciones automáticamente.</p></form>

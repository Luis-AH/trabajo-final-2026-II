@model SegundaOportunidad.Models.PanelAdminGuardViewModel
@{ Layout="_DashboardLayout"; ViewData["Title"]="Resumen de reporte y antecedentes"; var report=Model.ReporteActual!; }
<main class="p-3 p-md-5 guard-page"><partial name="_GuardNav" /><a asp-action="Reportes" class="guard-back">← Volver a buscar reportes</a><div class="guard-page-heading"><span class="guard-eyebrow">Resumen asistido</span><h1>De los hechos al contexto.</h1><p>La IA resume alegaciones y antecedentes agregados; no determina culpabilidad.</p></div><div class="row g-4"><div class="col-lg-5"><aside class="guard-context"><span class="guard-pill">@report.Estado</span><h2 class="h4 mt-3">@report.Motivo</h2><p style="white-space:pre-wrap">@report.Descripcion</p><div class="guard-context-stats"><div><strong>@Model.Antecedentes</strong><span>Otros reportes recibidos</span></div><div><strong>@Model.DecisionesSanciones</strong><span>Decisiones de sanciones</span></div></div><p class="guard-micro">Los reportes no son infracciones confirmadas; las decisiones incluyen advertencias y reactivaciones.</p><a asp-controller="AdminReportes" asp-action="Detalle" asp-route-id="@report.Id">Ver evidencias y revisión manual ↗</a></aside></div><div class="col-lg-7"><section class="card p-4"><h2 class="h5 mb-3">Preparar resumen y antecedentes</h2><partial name="_GuardForm" model="Model" /></section></div></div><partial name="_GuardHistory" model="Model" /></main>

@model SegundaOportunidad.Models.DetalleReporteViewModel
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Revisar reporte"; var r = Model.Reporte; }
<main class="p-3 p-md-5"><a asp-action="Index">Bandeja</a><a asp-controller="AdminGuard" asp-action="Index" asp-route-tipo="Reporte" asp-route-objetivoId="@r.Id" class="btn btn-outline-brand m-2">Resumir con AdminGuard</a><h1 class="h2 text-brand mt-3">Revisar reporte</h1><p>Referencia: @r.Id · <strong>@r.Estado</strong> · @r.CreadoUtc.ToString("yyyy-MM-dd HH:mm") UTC</p><p>Denunciante: @r.Denunciante.FullName · Denunciado: @r.Denunciado.FullName</p><p>Motivo: @r.Motivo</p><p style="white-space:pre-wrap">@r.Descripcion</p>
@if(!string.IsNullOrWhiteSpace(r.EvidenciaUrl)) { <p><a href="@r.EvidenciaUrl" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer">Abrir evidencia externa</a> (contenido aportado por el denunciante; no verificado)</p> }
@if(r.Articulo != null) { <h2 class="h5">Publicación actual: @r.Articulo.Title</h2><p>@r.Articulo.Description</p><a asp-controller="AdminPublicaciones" asp-action="Detalle" asp-route-id="@r.ArticuloId">Revisar fotografía y moderar publicación</a> }
<p class="mt-3">Otros reportes recibidos: @Model.Antecedentes · decisiones de sanciones: @Model.Sanciones</p><div class="d-flex flex-wrap gap-3 mb-4"><a asp-controller="AdminUsuarios" asp-action="Detalle" asp-route-id="@r.DenunciadoId">Antecedentes y sanciones del usuario</a><a asp-action="Index" asp-route-usuarioId="@r.DenunciadoId">Consultar otros reportes</a></div><p>Las sanciones y la moderación requieren su propia confirmación. Incluye la referencia de este reporte en el motivo para relacionar la decisión.</p>
@if(r.Estado is EstadoReporte.Pendiente or EstadoReporte.EnRevision) { <form asp-action="Decidir" method="post" class="card p-4 rounded-4" onsubmit="return confirm('¿Confirmas esta decisión? Se registrará con tu usuario y justificación.');"><input type="hidden" name="id" value="@r.Id" /><input type="hidden" name="version" value="@r.Version" /><label for="estado">Nuevo estado</label><select id="estado" name="estado" required class="form-select mb-3"><option value="">Selecciona</option>@if(r.Estado == EstadoReporte.Pendiente) { <option value="EnRevision">En revisión</option> } else { <option value="Resuelto">Resuelto</option> }<option value="Descartado">Descartado</option></select><label for="justificacion">Justificación (10–2000 caracteres)</label><textarea id="justificacion" name="justificacion" minlength="10" maxlength="2000" required class="form-control mb-3"></textarea><button class="btn btn-brand">Confirmar decisión</button></form> }
<h2 class="h5 mt-4">Historial de decisiones</h2><div class="table-responsive"><table class="table"><thead><tr><th>Fecha UTC</th><th>Administrador</th><th>Cambio</th><th>Justificación</th></tr></thead><tbody>@foreach(var d in Model.Decisiones) { <tr><td>@d.FechaUtc.ToString("yyyy-MM-dd HH:mm")</td><td>@d.Administrador.FullName</td><td>@d.Anterior → @d.Nuevo</td><td>@d.Justificacion</td></tr> }</tbody></table></div></main>

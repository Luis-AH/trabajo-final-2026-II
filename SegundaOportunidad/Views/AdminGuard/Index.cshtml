@model SegundaOportunidad.Models.PanelAdminGuardViewModel
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "AdminGuard IA"; }
<main class="p-3 p-md-5"><a asp-controller="Admin" asp-action="Index">Dashboard</a><h1 class="h2 text-brand mt-3">AdminGuard IA</h1><p class="text-muted">Asistencia para revisión humana · consultas de lectura</p><div class="alert alert-light border">La IA puede equivocarse. No determina si una imagen es falsa ni aplica sanciones. Las decisiones requieren revisión y confirmación en los formularios de moderación.</div>
@if(!Model.Configurado) { <div class="alert alert-warning">IA pendiente de configuración. Define AdminGuard:ApiKey y AdminGuard:Model mediante User Secrets o variables de entorno. No guardes la clave en archivos del repositorio.</div> }
@if(Model.Error != null) { <div class="alert alert-danger" role="alert">@Model.Error</div> }
<form asp-action="Consultar" method="post" class="card p-4 rounded-4"><label for="Tipo" class="form-label">Consulta</label><select id="Tipo" name="Tipo" required class="form-select mb-3"><option value="">Selecciona</option>@foreach(var t in Enum.GetValues<TipoConsultaAdminGuard>()) { <option value="@t" selected="@(Model.Consulta.Tipo == t)">@(t == TipoConsultaAdminGuard.Publicacion ? "Imagen, título y descripción" : t == TipoConsultaAdminGuard.Reporte ? "Resumen de reporte y antecedentes" : "Estadísticas y prioridades de revisión")</option> }</select><label for="ObjetivoId" class="form-label">Referencia de publicación o reporte (vacía para estadísticas)</label><input id="ObjetivoId" name="ObjetivoId" value="@Model.Consulta.ObjetivoId" maxlength="100" class="form-control mb-3" /><label for="Pregunta" class="form-label">Pregunta</label><textarea id="Pregunta" name="Pregunta" required minlength="5" maxlength="500" class="form-control mb-3">@Model.Consulta.Pregunta</textarea><p class="text-muted small">Al consultar se envían a Groq datos mínimos del objetivo y la fotografía en consultas de publicación. No incluyas datos personales ni secretos. Máximo diez consultas por administrador por hora, incluidos fallos; un análisis simultáneo por instancia.</p><button class="btn btn-brand" disabled="@(!Model.Configurado)">Consultar IA</button></form>
<h2 class="h5 mt-4">Tus últimos 20 análisis</h2><div class="table-responsive"><table class="table"><thead><tr><th>Fecha UTC</th><th>Tipo</th><th>Resultado</th><th>Detalle</th></tr></thead><tbody>@foreach(var a in Model.Historial) { <tr><td>@a.CreadoUtc.ToString("yyyy-MM-dd HH:mm")</td><td>@a.Tipo</td><td>@(a.Completado ? "Completado" : "No completado")</td><td><a asp-action="Resultado" asp-route-id="@a.Id">Consultar</a></td></tr> }</tbody></table></div></main>

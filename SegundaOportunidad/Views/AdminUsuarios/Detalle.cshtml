@model SegundaOportunidad.Models.AdminUsuarioDetalleViewModel
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Perfil administrativo"; var u = Model.Usuario; var propio = u.Id == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value; }
<main class="p-3 p-md-5"><a asp-action="Index">Volver a usuarios</a><h1 class="h2 text-brand mt-3">@u.FullName</h1><p>@u.Email</p>
<p>Registro UTC: @(u.RegisteredAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "Sin registro histórico")</p><p>Publicaciones: @Model.Publicaciones · Intercambios completados: @Model.Intercambios</p>
<p>Cuenta: @(u.AccountSuspendedUntilUtc > Model.AhoraUtc ? $"Suspendida hasta {u.AccountSuspendedUntilUtc:yyyy-MM-dd HH:mm} UTC" : "Sin suspensión vigente")</p><p>Publicación: @(u.PublishingSuspendedUntilUtc > Model.AhoraUtc ? $"Suspendida hasta {u.PublishingSuspendedUntilUtc:yyyy-MM-dd HH:mm} UTC" : "Permitida si la cuenta no está suspendida")</p>
<p>Reportes recibidos: @Model.Reportes (no equivalen a infracciones confirmadas). <a asp-controller="AdminReportes" asp-action="Index" asp-route-usuarioId="@u.Id">Consultar reportes</a></p><section class="card p-4 rounded-4"><h2 class="h5">Decisión administrativa</h2><p>Suspender publicaciones impide crear artículos y conserva los existentes. Las suspensiones vencen automáticamente. Reactivar la cuenta no levanta una suspensión independiente de publicaciones.</p>
@if(propio) { <p>No puedes suspenderte a ti mismo.</p> }
<form asp-action="Sancionar" method="post" onsubmit="return confirm('¿Confirmas esta decisión? Quedará registrada con tu usuario, motivo y fecha.');"><input type="hidden" name="id" value="@u.Id" /><input type="hidden" name="version" value="@u.SanctionVersion" /><label for="tipo">Acción</label><select id="tipo" name="tipo" class="form-select mb-3" required><option value="">Selecciona</option><option value="Advertencia">Advertencia</option>
@if(!propio && !(u.AccountSuspendedUntilUtc > Model.AhoraUtc)) { <option value="SuspenderCuenta">Suspender cuenta</option> }
@if(!propio && !(u.PublishingSuspendedUntilUtc > Model.AhoraUtc)) { <option value="SuspenderPublicaciones">Suspender publicaciones</option> }
@if(u.AccountSuspendedUntilUtc > Model.AhoraUtc) { <option value="ReactivarCuenta">Reactivar cuenta</option> }
@if(u.PublishingSuspendedUntilUtc > Model.AhoraUtc) { <option value="ReactivarPublicaciones">Reactivar publicaciones</option> }
</select><label for="horas">Horas (solo suspensiones, de 1 a 8760; dejar vacío para otras acciones)</label><input id="horas" name="horas" type="number" min="1" max="8760" class="form-control mb-3" /><label for="motivo">Motivo obligatorio</label><textarea id="motivo" name="motivo" required minlength="5" maxlength="1000" class="form-control mb-3"></textarea><button class="btn btn-brand">Confirmar decisión</button></form></section>
<h2 class="h5 mt-4">Historial de sanciones y reactivaciones</h2><div class="table-responsive"><table class="table"><thead><tr><th>Fecha UTC</th><th>Acción</th><th>Hasta UTC</th><th>Responsable</th><th>Motivo</th></tr></thead><tbody>@foreach(var s in Model.Historial) { <tr><td>@s.FechaUtc.ToString("yyyy-MM-dd HH:mm")</td><td>@s.Tipo</td><td>@(s.HastaUtc?.ToString("yyyy-MM-dd HH:mm") ?? "No aplica")</td><td>@s.Administrador.FullName</td><td>@s.Motivo</td></tr> }</tbody></table></div>@if(Model.Historial.Count == 0) { <p>Sin decisiones registradas.</p> }
<nav class="d-flex gap-3" aria-label="Historial">@if(Model.Pagina > 1) { <a asp-route-id="@u.Id" asp-route-pagina="@(Model.Pagina-1)">Anterior</a> }<span>@Model.Pagina de @Model.Paginas</span>@if(Model.Pagina < Model.Paginas) { <a asp-route-id="@u.Id" asp-route-pagina="@(Model.Pagina+1)">Siguiente</a> }</nav></main>

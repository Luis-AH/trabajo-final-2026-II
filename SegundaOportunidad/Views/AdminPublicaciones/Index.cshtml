@model SegundaOportunidad.Models.AdminPublicacionesViewModel
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Administrar publicaciones"; }
<main class="p-3 p-md-5">
<h1 class="h2 text-brand">Publicaciones</h1><p class="text-muted">Moderación con historial, sin eliminar artículos ni intercambios físicamente.</p>
<a asp-controller="Admin" asp-action="Index">Volver al dashboard</a>
@if (Model.ErrorBusqueda != null) { <div class="alert alert-warning mt-3">@Model.ErrorBusqueda</div> }
<form method="get" class="row g-3 my-3">
<div class="col-md-4"><label for="busqueda" class="form-label">Buscar con Algolia</label><input id="busqueda" name="busqueda" value="@Model.Busqueda" maxlength="150" class="form-control" /></div>
<div class="col-md-3"><label for="estado" class="form-label">Estado</label><select id="estado" name="estado" class="form-select"><option value="">Todos</option>@foreach (var e in Enum.GetValues<EstadoModeracion>()) { <option value="@e" selected="@(Model.Estado == e)">@e</option> }</select></div>
<div class="col-md-3"><label for="categoriaId" class="form-label">Categoría</label><select id="categoriaId" name="categoriaId" class="form-select"><option value="">Todas</option>@foreach(var c in Model.Categorias) { <option value="@c.Id" selected="@(c.Id == Model.CategoriaId)">@c.Name</option> }</select></div>
<div class="col-md-2 align-self-end"><button class="btn btn-brand w-100">Filtrar</button></div></form>
<p>@Model.Total publicaciones · página @Model.Pagina de @Model.Paginas</p>
<div class="table-responsive bg-white rounded-4 shadow-sm"><table class="table align-middle"><thead><tr><th>Publicación</th><th>Propietario</th><th>Categoría</th><th>Estado</th><th>Creación UTC</th><th>Acciones</th></tr></thead><tbody>
@foreach(var a in Model.Publicaciones) { <tr><td>@a.Title</td><td>@a.User?.FullName<br /><small>@a.User?.Email</small></td><td>@a.Categoria?.Name</td><td>@a.Moderacion<br /><small>@(a.IsActive ? "Activa" : "Inactiva")</small></td><td>@a.CreatedAt.ToString("yyyy-MM-dd")</td><td><a asp-action="Detalle" asp-route-id="@a.Id">Revisar</a></td></tr> }
</tbody></table></div>
@if (Model.Total == 0) { <p class="mt-3">No hay publicaciones para estos filtros.</p> }
<nav aria-label="Paginación" class="d-flex gap-3 mt-3">
@if(Model.Pagina > 1) { <a asp-route-pagina="@(Model.Pagina - 1)" asp-route-busqueda="@Model.Busqueda" asp-route-estado="@Model.Estado" asp-route-categoriaId="@Model.CategoriaId">Anterior</a> }
@if(Model.Pagina < Model.Paginas) { <a asp-route-pagina="@(Model.Pagina + 1)" asp-route-busqueda="@Model.Busqueda" asp-route-estado="@Model.Estado" asp-route-categoriaId="@Model.CategoriaId">Siguiente</a> }
</nav></main>

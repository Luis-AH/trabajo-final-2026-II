@model SegundaOportunidad.Models.ApplicationUser
@{ Layout="_DashboardLayout"; ViewData["Title"]="Verificar mi cuenta"; var approved=User.IsInRole("Admin") || (Model.IsVerified && Model.VerifiedAtUtc!=null && Model.VerifiedByAdminId!=null); }
<main class="p-3 p-md-5"><h1 class="h2 text-brand">Verificar mi cuenta</h1><p class="text-muted">Explora libremente. Para participar, solicita la aprobación del administrador.</p>
@if(TempData["VerificationError"] is string error) { <div class="alert alert-warning" role="alert">@error</div> }
<section class="card p-4 rounded-4">@if(approved) { <h2 class="h5">Cuenta aprobada</h2><p>Ya puedes publicar, conversar, intercambiar y reportar, sujeto a las reglas de la comunidad.</p><a asp-controller="Articulos" asp-action="Index" class="btn btn-brand">Explorar artículos</a> } else if(!string.IsNullOrEmpty(Model.Dni)) { <h2 class="h5">Solicitud pendiente</h2><p>El administrador debe revisar tu solicitud. Mientras tanto puedes consultar las publicaciones.</p><a asp-controller="Articulos" asp-action="Index" class="btn btn-outline-brand">Seguir explorando</a> } else { <h2 class="h5">Solicita tu aprobación</h2><p>Antes de publicar, conversar, proponer intercambios o reportar, un administrador debe aprobar tu cuenta. Esta revisión manual no es una consulta a RENIEC ni garantiza la autenticidad del DNI.</p><form asp-action="Solicitar" method="post"><label for="nombreCompleto" class="form-label">Nombres y apellidos completos</label><input id="nombreCompleto" name="nombreCompleto" value="@Model.FullName" type="text" autocomplete="name" minlength="3" maxlength="150" required class="form-control mb-3" placeholder="Ej.: Ana María Torres López" /><label for="dni" class="form-label">DNI (ocho dígitos)</label><input id="dni" name="dni" type="text" inputmode="numeric" pattern="[0-9]{8}" minlength="8" maxlength="8" required class="form-control mb-3" autocomplete="off" /><button class="btn btn-brand">Enviar solicitud al administrador</button></form> }</section><a asp-controller="Articulos" asp-action="Index" class="d-block mt-3">Volver al catálogo</a></main>

@model SegundaOportunidad.Models.GuardGalleryViewModel
@{ Layout="_DashboardLayout"; ViewData["Title"]="Revisar publicaciones con IA"; }
<main class="p-3 p-md-5 guard-page"><partial name="_GuardNav" /><div class="guard-page-heading"><span class="guard-eyebrow">02 / Revisión visual</span><h1>Encuentra. Observa. Revisa.</h1><p>Busca por nombre y elige una publicación para analizar su foto, descripción y señales de riesgo.</p></div>
<form method="get" class="card p-4 mb-4"><div class="row g-3 align-items-end"><div class="col-md-7"><label for="busqueda" class="form-label">Buscar por nombre de la publicación</label><input id="busqueda" name="busqueda" value="@Model.Busqueda" maxlength="150" class="form-control" placeholder="Ej.: bicicleta, escritorio, libros…" /></div><div class="col-md-3"><label for="estado" class="form-label">Estado de moderación</label><select id="estado" name="estado" class="form-select"><option value="">Todos</option>@foreach(var state in Enum.GetValues<EstadoModeracion>()) { <option value="@state" selected="@(state==Model.Estado)">@state</option> }</select></div><div class="col-md-2"><button class="btn btn-brand w-100">Buscar</button></div></div></form>
<div class="d-flex justify-content-between mb-3 guard-micro"><span>@Model.Total publicaciones encontradas</span><span>Página @Model.Pagina de @Model.Paginas · 12 por página</span></div>
@if(Model.Total==0) { <div class="guard-empty"><span aria-hidden="true">▧</span><h2>No encontramos publicaciones</h2><p>Prueba otro nombre o cambia el filtro de estado.</p><a asp-action="Publicaciones">Limpiar búsqueda</a></div> }
<div class="guard-publication-grid">@foreach(var a in Model.Publicaciones) { <article class="guard-publication-card"><div class="guard-image-wrap">@if(a.Imagen?.StartsWith("/Articulos/Imagen/",StringComparison.Ordinal)==true || (Uri.TryCreate(a.Imagen,UriKind.Absolute,out var url) && (url.Scheme=="https" || url.Scheme=="http"))) { <img src="@a.Imagen" alt="Fotografía de @a.Titulo" loading="lazy" referrerpolicy="no-referrer" /> } else { <div class="guard-image-placeholder"><span aria-hidden="true">↻</span>Sin fotografía</div> }<span class="guard-image-state">@a.Estado</span></div><div class="guard-publication-body"><span class="guard-eyebrow">@a.Categoria</span><h2>@a.Titulo</h2><p class="guard-clamp">@a.Descripcion</p><span class="guard-micro">Publicada @a.CreadoUtc.ToString("yyyy-MM-dd") UTC</span><a asp-action="Analizar" asp-route-id="@a.Id" class="btn btn-outline-brand w-100 mt-3">Revisar esta publicación →</a></div></article> }</div>
<nav class="guard-pagination" aria-label="Paginación de publicaciones">@if(Model.Pagina>1) { <a asp-route-pagina="@(Model.Pagina-1)" asp-route-busqueda="@Model.Busqueda" asp-route-estado="@Model.Estado">← Anterior</a> }<span>@Model.Pagina / @Model.Paginas</span>@if(Model.Pagina<Model.Paginas) { <a asp-route-pagina="@(Model.Pagina+1)" asp-route-busqueda="@Model.Busqueda" asp-route-estado="@Model.Estado">Siguiente →</a> }</nav></main>

@model SegundaOportunidad.Models.RecuperarClaveViewModel
@{ Layout="_AuthLayout"; ViewData["Title"]="Recuperar acceso"; }
<div class="p-4"><h1 class="h3 text-brand">Recuperar acceso</h1>@if(!(bool)ViewBag.CorreoConfigurado) { <div class="alert alert-warning">El envío de correo aún no está habilitado. Configura SMTP antes de solicitar un enlace real.</div> }<p>Si la cuenta existe y tiene correo confirmado, recibirás un enlace cuando el servicio de correo esté disponible.</p><form asp-action="Recuperar" method="post"><div asp-validation-summary="All" class="text-danger"></div><label asp-for="Email">Correo</label><input asp-for="Email" type="email" autocomplete="email" required maxlength="254" class="form-control mb-3" /><button class="btn btn-brand">Solicitar enlace</button></form><a asp-area="Identity" asp-page="/Account/Login" class="d-block mt-3">Volver al login</a></div>

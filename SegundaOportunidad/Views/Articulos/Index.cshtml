@model IEnumerable<SegundaOportunidad.Models.Articulo>
@using SegundaOportunidad.Models
@{ViewData["Title"]="Explorar catálogo";Layout="_DashboardLayout";var total=ViewData["Total"] as int? ?? Model.Count();var currentPage=ViewData["Pagina"] as int? ?? 1;var pages=Math.Max(1,(total+11)/12);}
<main class="p-4 p-md-5"><header class="catalog-header d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4"><div><span class="eyebrow">Objetos con historia, nuevas posibilidades</span><h1 class="display-6 fw-bold">Explorar Catálogo</h1><p class="text-muted">Compra, intercambia o recibe algo que todavía tiene mucho por dar.</p></div><a asp-action="Create" class="btn btn-brand">+ Publicar artículo</a></header>
@if(TempData["Success"] is string success){<div class="alert alert-success" role="status">@success</div>}
<form asp-action="Index" method="get" class="catalog-filter row g-3 mb-4"><div class="col-lg-5"><label for="catalog-search" class="form-label small">¿Qué estás buscando?</label><input id="catalog-search" name="searchString" maxlength="150" class="form-control" placeholder="Libros, bicicletas, una nueva idea…" value="@Context.Request.Query["searchString"]"/></div><div class="col-sm-6 col-lg-3"><label for="catalog-category" class="form-label small">Categoría</label><select id="catalog-category" name="categoriaId" class="form-select" asp-items="ViewBag.Categorias"><option value="">Todas las categorías</option></select></div><div class="col-sm-6 col-lg-2"><label for="catalog-price" class="form-label small">Venta hasta S/</label><input id="catalog-price" name="precioMax" type="number" min="0" step="1" class="form-control" placeholder="Sin límite" value="@Context.Request.Query["precioMax"]"/></div><div class="col-lg-2 d-flex align-items-end"><button class="btn btn-brand w-100">Buscar</button></div></form>
<div class="d-flex align-items-center justify-content-between mb-4 gap-3 flex-wrap"><p class="small text-muted mb-0">@total publicaciones disponibles · Página @currentPage de @pages</p><a asp-action="Index" class="small">Limpiar filtros</a></div>
@if(!Model.Any()){<section class="empty-state"><span class="eyebrow">Un nuevo comienzo</span><h2>Aún no encontramos esa oportunidad</h2><p class="text-muted">Prueba otra categoría o un término más general. No mostraremos artículos que ya no están disponibles.</p><a asp-action="Index" class="btn btn-outline-brand">Explorar todo</a></section>}
else{<div class="product-grid">@foreach(var item in Model){<article class="product-card"><a asp-action="Details" asp-route-id="@item.Id" class="product-cover"><img loading="lazy" src="@(item.ImageUrl??"/images/catalog-placeholder.svg")" alt="@item.Title"/></a><div class="product-body"><div class="product-tags"><span>@item.Categoria?.Name</span><span>@(item.Modalidad switch {ModalidadArticulo.Donacion=>"Donación",ModalidadArticulo.Intercambio=>"Intercambio",_=>"Venta"})</span>@if(item.Id.StartsWith("demo-ml-art-")){<span>DEMO</span>}</div><h2>@item.Title</h2><p class="product-description">@item.Description</p><p class="product-price">@(item.Modalidad switch {ModalidadArticulo.Donacion=>"Para donar",ModalidadArticulo.Intercambio=>"Busco un intercambio",_=>item.Price.HasValue?"S/ "+item.Price.Value.ToString("0.00"):"Consultar precio"})</p><div class="product-footer"><span>@item.EstadoFisico</span><a asp-action="Details" asp-route-id="@item.Id">Ver detalles →</a></div></div></article>}</div>}
<nav class="pagination-bar" aria-label="Páginas del catálogo">@if(currentPage>1){<a class="btn btn-outline-brand" asp-action="Index" asp-route-pagina="@(currentPage-1)" asp-route-searchString="@Context.Request.Query["searchString"]" asp-route-categoriaId="@Context.Request.Query["categoriaId"]" asp-route-precioMax="@Context.Request.Query["precioMax"]">← Anterior</a>}<span class="small text-muted">@currentPage / @pages</span>@if(currentPage<pages){<a class="btn btn-outline-brand" asp-action="Index" asp-route-pagina="@(currentPage+1)" asp-route-searchString="@Context.Request.Query["searchString"]" asp-route-categoriaId="@Context.Request.Query["categoriaId"]" asp-route-precioMax="@Context.Request.Query["precioMax"]">Siguiente →</a>}</nav>
<section class="ml-recommendations mt-5" data-query="@Context.Request.Query["searchString"]"><div class="section-heading"><div><span class="eyebrow">Descubrimientos por afinidad</span><h2>Una selección para ti</h2></div></div><p class="ml-status" role="status">Consultando el modelo de contenido…</p><div class="recommendation-grid"></div></section></main>

@page
@model LoginModel

@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<ul class="nav nav-tabs">
    <li class="nav-item">
        <a class="nav-link active" href="#">Iniciar Sesión</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Crear Cuenta</a>
    </li>
</ul>

<form id="account" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
    
    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label">Correo electrónico</label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nombre@ejemplo.com" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    
    <div class="mb-4">
        <label asp-for="Input.Password" class="form-label">Contraseña</label>
        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="••••••••" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="form-check">
            <input class="form-check-input" asp-for="Input.RememberMe" />
            <label asp-for="Input.RememberMe" class="form-check-label">
                Recordarme
            </label>
        </div>
        <a id="forgot-password" asp-page="./ForgotPassword" class="text-decoration-none" style="color: #1b4332;">¿Olvidaste tu contraseña?</a>
    </div>
    
    <button id="login-submit" type="submit" class="btn-brand">Ingresar a SegundaOportunidad</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

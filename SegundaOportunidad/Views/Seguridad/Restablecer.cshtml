@model SegundaOportunidad.Models.RestablecerClaveViewModel
@{ Layout="_AuthLayout"; ViewData["Title"]="Restablecer contraseña"; }
<div class="p-4"><h1 class="h3 text-brand">Restablecer contraseña</h1><form asp-action="Restablecer" method="post"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="Codigo" type="hidden" /><label asp-for="Email">Correo</label><input asp-for="Email" type="email" required autocomplete="email" class="form-control mb-3" /><label for="Nueva">Nueva contraseña</label><input type="password" id="Nueva" name="Nueva" required minlength="6" maxlength="100" autocomplete="new-password" class="form-control mb-3" /><label for="Confirmacion">Confirmar contraseña</label><input type="password" id="Confirmacion" name="Confirmacion" required autocomplete="new-password" class="form-control mb-3" /><p>Al menos seis caracteres, mayúscula, minúscula, número y símbolo. El enlace caduca en una hora; no lo compartas.</p><button class="btn btn-brand">Restablecer</button></form><a asp-action="Recuperar" class="d-block mt-3">Solicitar un enlace nuevo</a></div>

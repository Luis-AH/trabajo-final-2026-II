@model List<SegundaOportunidad.Models.Articulo>
@{
    ViewData["Title"] = "Mis Publicaciones";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid py-4 px-4 px-lg-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold text-dark mb-1">Mis Publicaciones</h2>
            <p class="text-muted mb-0">Gestiona todos tus artículos publicados</p>
        </div>
        <a asp-controller="Articulos" asp-action="Create" class="btn btn-brand rounded-pill px-4">
            <i class="bi bi-plus-circle me-2"></i>Nueva Publicación
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 mt-4">
            <div class="rounded-circle bg-brand-light d-flex align-items-center justify-content-center mx-auto mb-4" style="width: 80px; height: 80px;">
                <i class="bi bi-folder2-open text-brand" style="font-size: 2rem;"></i>
            </div>
            <h4 class="fw-bold text-dark mb-2">Aún no tienes publicaciones</h4>
            <p class="text-muted mb-4">¡Empieza publicando tu primer artículo y dale una segunda oportunidad a tus cosas!</p>
            <a asp-controller="Articulos" asp-action="Create" class="btn btn-brand rounded-pill px-5">
                <i class="bi bi-plus-circle me-2"></i>Publicar artículo
            </a>
        </div>
    }
    else
    {
        <!-- Stats row -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 text-center">
                    <div class="fs-4 fw-bold text-brand">@Model.Count</div>
                    <small class="text-muted">Total</small>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 text-center">
                    <div class="fs-4 fw-bold text-success">@Model.Count(a => a.Modalidad == SegundaOportunidad.Models.ModalidadArticulo.Venta)</div>
                    <small class="text-muted">Ventas</small>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 text-center">
                    <div class="fs-4 fw-bold text-info">@Model.Count(a => a.Modalidad == SegundaOportunidad.Models.ModalidadArticulo.Intercambio)</div>
                    <small class="text-muted">Intercambios</small>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 text-center">
                    <div class="fs-4 fw-bold text-warning">@Model.Count(a => a.Modalidad == SegundaOportunidad.Models.ModalidadArticulo.Donacion)</div>
                    <small class="text-muted">Donaciones</small>
                </div>
            </div>
        </div>

        <!-- Grid de artículos -->
        <div class="row g-3">
            @foreach (var articulo in Model)
            {
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                        <div style="height: 160px; overflow: hidden; background: #f0f0f0;">
                            @if (!string.IsNullOrEmpty(articulo.ImageUrl))
                            {
                                <img src="@articulo.ImageUrl" alt="@articulo.Title" class="w-100 h-100" style="object-fit: cover;">
                            }
                            else
                            {
                                <div class="w-100 h-100 d-flex align-items-center justify-content-center bg-brand-light">
                                    <i class="bi bi-box-seam text-brand" style="font-size: 2.5rem;"></i>
                                </div>
                            }
                        </div>
                        <div class="card-body p-3">
                            <div class="d-flex gap-1 mb-2">
                                <span class="badge bg-brand-light text-brand rounded-pill small">@articulo.Categoria?.Name</span>
                                <span class="badge bg-@(articulo.Modalidad == SegundaOportunidad.Models.ModalidadArticulo.Venta ? "success" : articulo.Modalidad == SegundaOportunidad.Models.ModalidadArticulo.Intercambio ? "info" : "warning")-subtle text-@(articulo.Modalidad == SegundaOportunidad.Models.ModalidadArticulo.Venta ? "success" : articulo.Modalidad == SegundaOportunidad.Models.ModalidadArticulo.Intercambio ? "info" : "warning") rounded-pill small">@articulo.Modalidad</span>
                            </div>
                            <h6 class="fw-bold text-dark mb-1 text-truncate">@articulo.Title</h6>
                            <p class="text-muted small mb-2 text-truncate">@articulo.Description</p>
                            @if (articulo.Modalidad == SegundaOportunidad.Models.ModalidadArticulo.Venta && articulo.Price.HasValue)
                            {
                                <div class="fw-bold text-brand">S/ @articulo.Price.Value.ToString("0.0")</div>
                            }
                            else if (articulo.Modalidad == SegundaOportunidad.Models.ModalidadArticulo.Donacion)
                            {
                                <div class="fw-bold text-success">Gratis</div>
                            }
                            else
                            {
                                <div class="fw-bold text-info">Busco intercambio</div>
                            }
                        </div>
                        <div class="card-footer bg-white border-0 p-3 pt-0 d-flex gap-2">
                            <a asp-controller="Articulos" asp-action="Details" asp-route-id="@articulo.Id" class="btn btn-outline-brand btn-sm rounded-pill flex-grow-1">Ver</a>
                            <a asp-controller="Articulos" asp-action="Edit" asp-route-id="@articulo.Id" class="btn btn-outline-secondary btn-sm rounded-pill">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .bg-brand-light { background-color: rgba(33, 115, 70, 0.1) !important; }
    .text-brand { color: #217346 !important; }
    .btn-brand { background-color: #217346; color: white; border-color: #217346; }
    .btn-brand:hover { background-color: #1a5c38; color: white; }
    .btn-outline-brand { color: #217346; border-color: #217346; }
    .btn-outline-brand:hover { background-color: #217346; color: white; }
</style>

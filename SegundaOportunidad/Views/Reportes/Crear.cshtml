@model SegundaOportunidad.Models.CrearReporteViewModel
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Enviar reporte"; }
<main class="p-3 p-md-5"><h1 class="h2 text-brand">Enviar reporte</h1><p>Describe los hechos y aporta evidencia. Un administrador revisará el reporte; enviarlo no aplica sanciones automáticamente.</p><form asp-action="Crear" method="post" class="card p-4 rounded-4"><div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="ArticuloId" type="hidden" /><input asp-for="UsuarioId" type="hidden" /><label asp-for="Motivo" class="form-label">Motivo</label><select asp-for="Motivo" asp-items="Html.GetEnumSelectList<MotivoReporte>()" class="form-select mb-3" required><option value="">Selecciona</option></select><label asp-for="Descripcion" class="form-label">Descripción y evidencias (10–2000 caracteres)</label><textarea asp-for="Descripcion" class="form-control mb-3" minlength="10" maxlength="2000" required></textarea><label asp-for="EvidenciaUrl" class="form-label">Enlace de evidencia HTTPS (opcional)</label><input asp-for="EvidenciaUrl" type="url" class="form-control mb-3" maxlength="1000" /><p class="text-muted">No incluyas contraseñas, tokens ni datos personales innecesarios.</p><button class="btn btn-brand">Enviar a revisión</button></form></main>

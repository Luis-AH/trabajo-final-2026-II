@model SegundaOportunidad.Models.PanelAdminGuardViewModel
@{ Layout="_DashboardLayout"; ViewData["Title"]="Consultar datos con IA"; }
<main class="p-3 p-md-5 guard-page"><partial name="_GuardNav" /><div class="guard-page-heading"><span class="guard-eyebrow">01 / Información de la comunidad</span><h1>Convierte datos en contexto.</h1><p>Consulta las estadísticas globales que AdminGuard tiene disponibles y prepara tus próximas revisiones.</p></div><div class="row g-4"><div class="col-lg-7"><section class="card p-4"><h2 class="h5 mb-3">Tu pregunta sobre los datos</h2><partial name="_GuardForm" model="Model" /></section></div><div class="col-lg-5"><aside class="guard-context"><span class="guard-pill">Solo lectura</span><h2>Empieza con una pregunta.</h2><p>Los datos disponibles incluyen usuarios, publicaciones, intercambios por estado y reportes por motivo y estado.</p><button type="button" class="guard-preset" data-question="¿Cuántos intercambios hay por estado y qué significa esa distribución?">¿Cómo van los intercambios? ↗</button><button type="button" class="guard-preset" data-question="Según los reportes abiertos por motivo, ¿qué conviene revisar primero y qué límites tiene esa recomendación?">¿Qué revisiones conviene priorizar? ↗</button><button type="button" class="guard-preset" data-question="Resume los totales de usuarios y publicaciones sin atribuir actividad o legitimidad que no esté comprobada.">Dame un panorama general ↗</button><p class="guard-micro mt-3">Las cifras son globales al momento de consultar. Si una pregunta necesita datos no disponibles, la IA debe indicarlo.</p></aside></div></div><partial name="_GuardHistory" model="Model" /></main>
@section Scripts { <script>document.querySelectorAll('[data-question]').forEach(button=>button.addEventListener('click',()=>{const field=document.getElementById('Pregunta');field.value=button.dataset.question;field.focus();}));</script> }
